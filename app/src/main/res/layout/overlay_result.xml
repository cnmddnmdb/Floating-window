<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:layout_gravity="center"
    android:layout_marginStart="20dp"
    android:layout_marginEnd="20dp"
    android:layout_marginTop="100dp"
    android:background="@drawable/result_overlay_bg"
    android:padding="16dp"
    android:elevation="16dp">

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="📷 识别结果"
        android:textSize="14sp"
        android:textColor="#BBFFFFFF"
        android:fontFamily="sans-serif-medium"
        android:layout_marginBottom="8dp" />

    <TextView
        android:id="@+id/tvRecognized"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text=""
        android:textSize="14sp"
        android:textColor="#FFFFFF"
        android:lineSpacingExtra="4dp"
        android:padding="12dp"
        android:background="@drawable/recognized_bg"
        android:layout_marginBottom="12dp" />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="🌐 翻译结果"
        android:textSize="14sp"
        android:textColor="#BBFFFFFF"
        android:fontFamily="sans-serif-medium"
        android:layout_marginBottom="8dp" />

    <TextView
        android:id="@+id/tvTranslated"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="点击「翻译」按钮进行翻译"
        android:textSize="14sp"
        android:textColor="#FFFFFF"
        android:lineSpacingExtra="4dp"
        android:padding="12dp"
        android:background="@drawable/translated_bg"
        android:layout_marginBottom="12dp" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center">

        <Button
            android:id="@+id/btnCloseResult"
            android:layout_width="0dp"
            android:layout_height="40dp"
            android:layout_weight="1"
            android:text="关闭"
            android:textSize="13sp"
            android:background="@drawable/btn_close_bg"
            android:textColor="#FFFFFF"
            android:layout_marginEnd="8dp" />

        <Button
            android:id="@+id/btnTranslateResult"
            android:layout_width="0dp"
            android:layout_height="40dp"
            android:layout_weight="1"
            android:text="翻译"
            android:textSize="13sp"
            android:background="@drawable/btn_translate_bg"
            android:textColor="#FFFFFF"
            android:layout_marginStart="8dp" />

    </LinearLayout>

</LinearLayout>
