<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#88000000">

    <View
        android:id="@+id/selectionFrame"
        android:layout_width="200dp"
        android:layout_height="150dp"
        android:layout_gravity="center"
        android:background="@drawable/selection_frame_bg" />

    <TextView
        android:id="@+id/tvHint"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="top|center_horizontal"
        android:layout_marginTop="60dp"
        android:text="拖动调整区域 | 准备好后点识别并截图"
        android:textSize="13sp"
        android:textColor="#FFFFFF"
        android:paddingHorizontal="16dp"
        android:paddingVertical="8dp"
        android:background="#88000000" />

    <Button
        android:id="@+id/btnCloseOverlay"
        android:layout_width="110dp"
        android:layout_height="48dp"
        android:layout_gravity="bottom|start"
        android:layout_marginStart="24dp"
        android:layout_marginBottom="24dp"
        android:text="关闭"
        android:textSize="15sp"
        android:background="@drawable/btn_close_bg"
        android:textColor="#FFFFFF" />

    <LinearLayout
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom|end"
        android:layout_marginEnd="24dp"
        android:layout_marginBottom="24dp"
        android:orientation="horizontal">

        <Button
            android:id="@+id/btnCapture"
            android:layout_width="110dp"
            android:layout_height="48dp"
            android:text="识别"
            android:textSize="15sp"
            android:background="@drawable/btn_translate_bg"
            android:textColor="#FFFFFF" />

    </LinearLayout>

</FrameLayout>
